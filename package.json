{
  "name": "sahayog-setu",
  "version": "1.0.0",
  "description": "Crowdsourced Societal Problem-Solving Platform for Smart India Hackathon",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"node backend/server.js\" \"npm --prefix frontend run dev\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exif-parser": "^0.1.12",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "multer": "^2.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
